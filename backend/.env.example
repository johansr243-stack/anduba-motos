# Puerto del servidor
PORT=3000

# Semilla para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SEED=cambia_esto_por_una_clave_segura

# Cadena de conexión a MongoDB (local o Atlas)
DB_URI=mongodb://127.0.0.1:27017/Ecommerce

# Cuenta de Gmail para enviar el código de recuperación de contraseña
# (usa una "contraseña de aplicación" de Google, no tu contraseña normal)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion

# Cloudinary (opcional en local). Si las 3 están definidas, las imágenes se
# suben a Cloudinary; si no, se guardan en la carpeta local /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
